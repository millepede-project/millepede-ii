export LD_LIBRARY_PATH=@CMAKE_INSTALL_PREFIX@/lib:$LD_LIBRARY_PATH
export PATH=@CMAKE_INSTALL_PREFIX@/bin:$PATH
export PYTHONPATH=@CMAKE_INSTALL_PREFIX@/python:$PYTHONPATH
export PEDE_BUILD_DIR=@millepedeII_BINARY_DIR@
export PEDE_SRC_DIR=@millepedeII_SOURCE_DIR@
export millepedeII_DIR=@CMAKE_INSTALL_PREFIX@/cmake
export CMAKE_PREFIX_PATH=@CMAKE_INSTALL_PREFIX@/cmake:$CMAKE_PREFIX_PATH
if [[ ! -z "@MILLE_AS_SUBDIR@" ]]; then export Mille_DIR=@CMAKE_INSTALL_PREFIX@/cmake; fi 
